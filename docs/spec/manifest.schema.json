{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.run/spec/superapp/0.1/manifest.schema.json",
  "title": "Suite pack manifest",
  "description": "The signed manifest a Suite host verifies before running a pack. Every field except signature is covered by the canonical bytes. Unknown top-level fields are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "version",
    "entry",
    "contractVersion",
    "publisher",
    "capabilities",
    "files",
    "signature"
  ],
  "properties": {
    "format": { "const": "suite.pack" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+\\.html$"
    },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "minimumHostVersion": { "type": "integer", "minimum": 1 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 32 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "optionalCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "documents": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/document" }
    },
    "blobs": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/blob" }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "blobs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(https|wss)://[A-Za-z0-9.-]+(?::[0-9]{1,5})?$"
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "mobile"] }
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["pointer", "touch", "keyboard"] }
    },
    "defaultLocale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
    },
    "widgets": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/widget" }
    },
    "codeWidgets": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/codeWidget" }
    },
    "components": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/component" }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": { "type": "array", "maxItems": 200, "items": { "type": "object", "additionalProperties": true } },
        "menus": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": true } },
        "fileExtensions": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9+.-]*$" }
        },
        "deepLinks": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "subpackages": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/subpackage" }
    },
    "addons": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/addon" }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source": { "type": "string", "pattern": "^https://" },
    "deprecated": { "type": "boolean" },
    "replacement": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sunset": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/file" }
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "capability": {
      "enum": [
        "documents",
        "storage",
        "files",
        "recents",
        "notifications",
        "network",
        "relay",
        "commands",
        "identity.pack",
        "sync",
        "widget.code",
        "media.map",
        "media.camera",
        "media.model3d",
        "media.ar",
        "media.vision"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "format": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["single", "multi"] },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "entry"],
            "properties": {
              "from": { "type": "integer", "minimum": 1 },
              "to": { "type": "integer", "minimum": 1 },
              "entry": { "type": "string", "minLength": 1 }
            }
          }
        },
        "projection": { "type": "string", "minLength": 1 },
        "criticalFields": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "class"],
      "properties": {
        "store": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "class": { "enum": ["asset", "derived", "cache"] }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "size", "capabilities", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "size": { "enum": ["1x1", "2x1", "full"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["capture"] } },
        "action": { "type": "object", "additionalProperties": true },
        "settings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "data": { "$ref": "#/$defs/widgetData" }
      }
    },
    "codeWidget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "size", "capabilities", "action", "entry", "sha256", "fallback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "size": { "enum": ["1x1", "2x1", "full"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["capture"] } },
        "action": { "type": "object", "additionalProperties": true },
        "settings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "data": { "$ref": "#/$defs/widgetData" },
        "entry": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+\\.html$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "size", "capabilities", "action"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 60 },
            "size": { "enum": ["1x1", "2x1", "full"] },
            "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["capture"] } },
            "action": { "type": "object", "additionalProperties": true },
            "settings": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
            "data": { "$ref": "#/$defs/widgetData" }
          }
        }
      }
    },
    "widgetData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "enum": ["projection", "scoped", "full"] },
        "read": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "write": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fallback"],
      "properties": {
        "kind": { "enum": ["map", "video", "camera", "model3d", "ar.surface"] },
        "fallback": { "enum": ["web", "none"] }
      }
    },
    "subpackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "entry": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+\\.html$"
        }
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
