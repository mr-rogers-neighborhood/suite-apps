{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suite.run/spec/superapp/manifest.schema.json",
  "title": "Suite pack manifest",
  "description": "The signed manifest a Suite host verifies before running a pack. Unknown top-level fields are refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "name",
    "version",
    "entry",
    "contractVersion",
    "capabilities",
    "files",
    "signature"
  ],
  "properties": {
    "format": { "const": "suite.pack" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/].*\\.html$"
    },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "minimumHostVersion": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "documents",
          "storage",
          "files",
          "recents",
          "notifications",
          "network",
          "relay",
          "commands",
          "identity.device",
          "sync",
          "widget.code",
          "media.map",
          "media.camera",
          "media.model3d",
          "media.ar",
          "media.vision"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "blobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/blob" }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documents": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blobs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(https|wss)://[^\\s]+$"
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["desktop", "mobile"] }
    },
    "input": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["pointer", "touch", "keyboard"] }
    },
    "widgets": {
      "type": "array",
      "items": { "$ref": "#/$defs/widget" }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": { "type": "array", "items": { "type": "object" } },
        "menus": { "type": "array", "items": { "type": "object" } },
        "fileExtensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9+.-]*$" }
        },
        "deepLinks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "subpackages": {
      "type": "array",
      "items": { "$ref": "#/$defs/subpackage" }
    },
    "addons": {
      "type": "array",
      "items": { "$ref": "#/$defs/addon" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "format": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["single", "multi"] }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "class"],
      "properties": {
        "store": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "class": { "enum": ["asset", "derived", "cache"] }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "size": { "enum": ["1x1", "2x1", "full"] },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "action": { "type": "object" },
        "settings": { "type": "array", "items": { "type": "object" } },
        "render": { "enum": ["declarative", "sandboxed"] },
        "entry": { "type": "string", "pattern": "^[^/].*\\.html$" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "subpackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "entry": { "type": "string", "pattern": "^[^/].*\\.html$" }
      }
    },
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
