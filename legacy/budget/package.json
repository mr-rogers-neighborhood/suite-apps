{
  "name": "@suite/budget",
  "productName": "Suite Budget",
  "desktopName": "run.suite.budget",
  "version": "0.4.4",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build-storybook": "storybook build",
    "dev": "electron-vite dev",
    "e2e:smoke": "playwright test",
    "e2e:proof": "playwright test --grep @proof",
    "package:dir": "electron-vite build && electron-builder --dir",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:all": "pnpm --filter @suite/budget --filter @suite/budget-core run typecheck",
    "lint": "node ../../scripts/lint.mjs",
    "lint:fix": "node ../../scripts/lint.mjs --write",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "shape": "node scripts/check-shape.mjs",
    "knip": "knip",
    "check": "node ../../scripts/lint.mjs && pnpm typecheck:all && vitest run --changed && pnpm shape",
    "check:full": "pnpm lint && pnpm typecheck:all && pnpm test && pnpm shape && pnpm knip && pnpm build",
    "verify": "node ../../scripts/lint.mjs && pnpm typecheck:all && vitest run && pnpm shape && pnpm knip && pnpm build && pnpm build-storybook",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@suite/budget-core": "workspace:*",
    "@suite/contracts": "workspace:*",
    "@suite/desktop": "workspace:*",
    "@suite/document-runtime": "workspace:*",
    "loro-crdt": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5"
  },
  "description": "A local-first envelope budget",
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT",
  "homepage": "https://github.com/mrrnbhd/suite-apps",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  }
}
