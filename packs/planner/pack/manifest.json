{
  "id": "planner",
  "name": "Suite Planner",
  "description": "A local-first day plan in one file.",
  "version": "0.5.3",
  "entry": "index.html",
  "contractVersion": 1,
  "capabilities": ["documents", "files", "notifications", "recents"],
  "optionalCapabilities": ["relay", "commands"],
  "platforms": ["desktop", "mobile"],
  "documents": [
    {
      "id": "workspace",
      "format": "suite.planner",
      "version": 2,
      "name": { "singular": "Planner", "plural": "Planners" },
      "mode": "multi",
      "projection": "reminders"
    }
  ],
  "contributions": {
    "commands": [
      {
        "id": "planner.quick-task",
        "title": "Quick task",
        "subtitle": "Capture into Planner",
        "keywords": ["task", "todo", "capture", "add"],
        "scope": "global",
        "provider": "commands"
      },
      {
        "id": "planner.today",
        "title": "Open Today",
        "subtitle": "Planner",
        "keywords": ["today", "day", "plan"],
        "scope": "global",
        "provider": "commands"
      },
      {
        "id": "planner.inbox",
        "title": "Open Inbox",
        "subtitle": "Planner",
        "keywords": ["inbox", "unscheduled", "tasks"],
        "scope": "global",
        "provider": "commands"
      }
    ],
    "providers": [
      { "kind": "commands", "entry": "commands", "scopes": ["global"] },
      { "kind": "scopes", "entry": "scopes", "scopes": ["today", "inbox"] }
    ]
  }
}
