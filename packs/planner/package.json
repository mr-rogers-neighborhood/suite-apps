{
  "name": "@suite/planner-pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "suite": {
    "pack": true
  },
  "description": "Planner's pack source and its build. The renderer is owned here; the Electron shell consumes it.",
  "scripts": {
    "build": "vite build --config pack/vite.config.ts",
    "typecheck": "tsc --noEmit -p pack/tsconfig.json",
    "test": "vitest run --config pack/vitest.config.mts",
    "check:full": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@suite/document-runtime": "workspace:*",
    "@suite/pack-runtime": "workspace:*",
    "@suite/planner-core": "workspace:*",
    "@suite/sync": "workspace:*",
    "@suite/ui": "workspace:*",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "loro-prosemirror": "0.4.4",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
