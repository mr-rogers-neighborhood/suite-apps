{
  "name": "@suite/canvas-pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "suite": {
    "pack": true
  },
  "description": "Canvas's pack source and its build. The Electron shell stays in legacy/canvas.",
  "scripts": {
    "build": "vite build --config pack/vite.config.ts",
    "typecheck": "tsc --noEmit -p pack/tsconfig.json",
    "test": "vitest run --config pack/vitest.config.mts",
    "check:full": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@iconify-json/lucide": "^1.2.147",
    "@noble/ciphers": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@suite/contracts": "workspace:*",
    "@suite/graph": "workspace:*",
    "@suite/import-obsidian": "workspace:*",
    "@suite/pack-runtime": "workspace:*",
    "@suite/sync": "workspace:*",
    "@suite/sync-desktop": "workspace:*",
    "@suite/ui": "workspace:*",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@xyflow/react": "^12.12.0",
    "fuzzysort": "^4.0.2",
    "loro-crdt": "^1.17.1",
    "loro-prosemirror": "0.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "storybook": "10.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "5.0.5"
