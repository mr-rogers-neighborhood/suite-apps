{
  "name": "@suite/help-pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "suite": {
    "pack": true
  },
  "description": "Help's renderer, generator and pack build. The Electron shell stays in legacy/help.",
  "scripts": {
    "index": "node scripts/index-code.mjs",
    "index:check": "node scripts/index-code.mjs --check",
    "sync": "node scripts/sync-docs.mjs",
    "build": "pnpm index && pnpm sync && vite build --config pack/vite.config.ts",
    "typecheck": "tsc --noEmit -p pack/tsconfig.json",
    "test": "pnpm index && pnpm sync && vitest run --config pack/vitest.config.mts",
    "check:full": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@suite/theme": "workspace:*",
    "lucide-react": "^1.71.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fumadocs-core": "16.19.5",
    "fumadocs-mdx": "15.6.4",
    "jsdom": "^30.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "^8.5.1",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT"
}
