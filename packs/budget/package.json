{
  "name": "@suite/budget-pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "suite": {
    "pack": true
  },
  "description": "Budget's pack source and its build. The Electron shell stays in legacy/budget.",
  "scripts": {
    "build": "vite build --config pack/vite.config.ts",
    "typecheck": "tsc --noEmit -p pack/tsconfig.json",
    "test": "vitest run --config pack/vitest.config.mts",
    "check:full": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@suite/budget-core": "workspace:*",
    "@suite/pack-runtime": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
