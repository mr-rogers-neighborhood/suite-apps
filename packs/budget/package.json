{
  "name": "@suite/budget-pack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "suite": {
    "pack": true
  },
  "description": "Budget's pack source and its build. The Electron shell is frozen in legacy/budget.",
  "scripts": {
    "build": "vite build --config pack/vite.config.ts",
    "typecheck": "tsc --noEmit -p pack/tsconfig.json && pnpm --dir packages/core run typecheck",
    "test": "vitest run --config pack/vitest.config.mts",
    "check:full": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@suite/budget-core": "workspace:*",
    "@suite/document-runtime": "workspace:*",
    "@suite/pack-runtime": "workspace:*",
    "@suite/ui": "workspace:*",
    "clsx": "^2.1.1",
    "fuzzysort": "^4.0.2",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
