{
  "name": "suite-apps",
  "private": true,
  "version": "0.0.0",
  "description": "The Suite: a local-first hub, apps and sync server in one workspace.",
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/gate.mjs",
    "check:all": "node scripts/gate.mjs",
    "gate:fresh": "node scripts/gate.mjs --fresh",
    "docs:check": "node scripts/docs-check.mjs",
    "proof": "node scripts/proof-of-changes.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "spec:check": "node --test scripts/spec.test.mjs scripts/spec-golden.test.mjs",
    "profile:check": "node scripts/profile-check.mjs",
    "docs:index": "pnpm --dir legacy/help index",
    "docs:index:check": "pnpm --dir legacy/help index:check",
    "docs:coverage": "pnpm --dir legacy/help coverage",
    "docs:explain": "pnpm --dir legacy/help explain",
    "docs:dev": "pnpm --dir legacy/help dev",
    "docs:build": "pnpm --dir legacy/help build",
    "docs:clean": "pnpm --dir legacy/help clean",
    "keys": "node scripts/keys.mjs",
    "android:key": "node scripts/android-release.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:index": "node scripts/pack-index.mjs",
    "budget:pack": "node scripts/budget-pack.mjs",
    "planner:pack": "node scripts/planner-pack.mjs",
    "canvas:pack": "node scripts/canvas-pack.mjs",
    "help:pack": "node scripts/help-pack.mjs",
    "format": "pnpm --filter \"./hosts/*\" --filter \"./hosts/*/packages/*\" --filter \"./legacy/*\" --filter \"./legacy/*/*\" --filter \"./legacy/*/packages/*\" --filter \"./services/*\" --filter \"./services/*/*\" --filter \"./services/*/packages/*\" --filter \"./packages/*\" --workspace-concurrency=1 run format",
    "build": "pnpm --filter \"./hosts/*\" --filter \"./hosts/*/packages/*\" --filter \"./legacy/*\" --filter \"./legacy/*/*\" --filter \"./legacy/*/packages/*\" --filter \"./services/*\" --filter \"./services/*/*\" --filter \"./services/*/packages/*\" --filter \"./packages/*\" --workspace-concurrency=1 run build",
    "prepare": "husky && node scripts/pack-links.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@suite/pack": "workspace:*",
    "@suite/pack-host": "workspace:*",
    "husky": "^9.1.7"
  }
}
