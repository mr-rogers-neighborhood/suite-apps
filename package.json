{
  "name": "suite-apps",
  "private": true,
  "version": "0.0.0",
  "description": "The Suite: a local-first hub, apps and sync server in one workspace.",
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/gate.mjs",
    "check:all": "node scripts/gate.mjs",
    "gate:fresh": "node scripts/gate.mjs --fresh",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:index": "pnpm --dir apps/help index",
    "docs:index:check": "pnpm --dir apps/help index:check",
    "docs:coverage": "pnpm --dir apps/help coverage",
    "docs:explain": "pnpm --dir apps/help explain",
    "docs:dev": "pnpm --dir apps/help dev",
    "docs:build": "pnpm --dir apps/help build",
    "docs:clean": "pnpm --dir apps/help clean",
    "keys": "node scripts/keys.mjs",
    "format": "pnpm --filter \"./apps/*\" --filter \"./apps/*/*\" --filter \"./packages/*\" --workspace-concurrency=1 run format",
    "build": "pnpm --filter \"./apps/*\" --filter \"./apps/*/*\" --filter \"./packages/*\" --workspace-concurrency=1 run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
