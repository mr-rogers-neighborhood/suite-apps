{
  "name": "@suite/sync-server",
  "version": "0.11.3",
  "private": true,
  "description": "The headless Suite sync server: rooms, WebSocket transport, snapshots, workspace bootstrap and CLI.",
  "type": "module",
  "bin": {
    "suite-sync": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:all": "pnpm --filter @suite/sync --filter @suite/host --filter @suite/sync-server --workspace-concurrency=1 run build",
    "typecheck:all": "pnpm --filter @suite/sync-server --filter @suite/host --filter @suite/sync run typecheck",
    "check": "biome check . && pnpm build:all && pnpm typecheck:all && vitest run",
    "check:full": "pnpm check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "verify": "pnpm check",
    "release:relay": "node scripts/release.mjs",
    "release:verify": "node scripts/release.mjs --verify dist/release --public $SUITE_SYNC_RELEASE_PUBLIC",
    "verify:relay": "node scripts/verify-relay.mjs"
  },
  "dependencies": {
    "@suite/host": "workspace:*",
    "@suite/sync": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "@types/ws": "^8.18.2"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
