# Where the relay keeps its frames. `StateDirectory=suite-sync` in the unit creates this and makes it
# the only writable path the service has.
SUITE_SYNC_ARGS=--store /var/lib/suite-sync --trust-all

# To let other devices on your network reach the mailbox, add the address and the acknowledgement:
#
#   SUITE_SYNC_ARGS=--store /var/lib/suite-sync --trust-all --trust-all-remote --host 0.0.0.0
#
# Read docs/how-to/relay.md first. `--trust-all` admits a frame from any device, because there is no
# device registry yet; on `0.0.0.0` that is every device that can route to this port.
