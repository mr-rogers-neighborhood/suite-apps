# Where the relay keeps its frames. `StateDirectory=suite-sync` in the unit creates this and makes it
# the only writable path the service has.
#
# The default is loopback only. `--trust-all` admits a frame from any device that can reach
# 127.0.0.1, because the CLI has no device-key verifier yet.
SUITE_SYNC_ARGS=--store /var/lib/suite-sync --trust-all --host 127.0.0.1

# To let other devices on your network reach the mailbox, add the acknowledgement, the address and
# the self-signed pair. A reachable address is refused without TLS. Start makes this pair itself
# under its data directory; a relay run by hand needs one of its own:
#
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
#     -keyout /etc/suite-sync/relay-key.pem -out /etc/suite-sync/relay-cert.pem -days 3650 \
#     -subj "/CN=suite-sync relay"
#   chmod 600 /etc/suite-sync/relay-key.pem /etc/suite-sync/relay-cert.pem
#
#   SUITE_SYNC_ARGS=--store /var/lib/suite-sync --trust-all --trust-all-remote --host 0.0.0.0 --tls-cert /etc/suite-sync/relay-cert.pem --tls-key /etc/suite-sync/relay-key.pem
#
# On `0.0.0.0` that admits every device that can route to this port: any of them can join, write
# frames and membership, and the relay does not verify the role a record claims. Read
# docs/how-to/relay.md first. The relay prints the certificate's SHA-256 fingerprint at startup;
# each device pins that line. Keep it stable until the pair is deliberately replaced.
