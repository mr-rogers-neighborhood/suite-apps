{
  "name": "@suite/canvas",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "VITE_SUITE_MODE=standalone vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:stories": "vitest run --config vitest.stories.config.ts",
    "dev:standalone": "VITE_SUITE_MODE=standalone vite",
    "build:all": "pnpm --filter @suite/graph --filter @suite/import-obsidian --filter @suite/canvas --filter @suite/canvas-desktop --workspace-concurrency=1 run build",
    "typecheck:all": "pnpm --filter @suite/graph --filter @suite/import-obsidian --workspace-concurrency=1 run build && pnpm --filter @suite/canvas --filter @suite/canvas-desktop --filter @suite/graph --filter @suite/import-obsidian run typecheck",
    "bench": "vitest bench --config vitest.bench.config.ts --reporter=verbose",
    "check": "biome check . && pnpm typecheck:all && vitest run --changed && pnpm docs:symbols && pnpm shape",
    "check:full": "pnpm lint && pnpm typecheck:all && pnpm test && pnpm test:stories && pnpm build:all && pnpm docs:check && pnpm docs:symbols && pnpm shape && pnpm security:secrets",
    "clean": "rm -rf dist desktop/dist packages/*/dist .turbo desktop/.turbo packages/*/.turbo",
    "coverage": "vitest run --coverage",
    "coverage:graph": "vitest run --coverage --project=graph --coverage.include=packages/graph/src/**",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "docs:check": "node scripts/docs-check.mjs && node scripts/generate-doc-indexes.mjs --check && node scripts/sync-handbook.mjs --check",
    "docs:index": "node scripts/generate-doc-indexes.mjs",
    "docs:symbols": "node scripts/check-docs-symbols.mjs",
    "doctor": "node scripts/doctor.mjs",
    "e2e": "pnpm --filter @suite/e2e e2e",
    "e2e:canvas": "pnpm --filter @suite/e2e e2e:canvas",
    "e2e:changed": "pnpm --filter @suite/e2e e2e:changed",
    "e2e:desktop": "pnpm --filter @suite/e2e e2e:desktop",
    "e2e:doctor": "pnpm --filter @suite/e2e e2e:doctor",
    "e2e:full": "pnpm --filter @suite/e2e e2e:full",
    "e2e:headed": "pnpm --filter @suite/e2e e2e:headed",
    "e2e:logs": "pnpm --filter @suite/e2e e2e:logs",
    "e2e:smoke": "pnpm --filter @suite/e2e e2e:smoke",
    "e2e:stop": "pnpm --filter @suite/e2e e2e:stop",
    "e2e:trace": "pnpm --filter @suite/e2e e2e:trace",
    "e2e:ui": "pnpm --filter @suite/e2e e2e:ui",
    "e2e:ui:stop": "pnpm --filter @suite/e2e e2e:ui:stop",
    "e2e:views": "pnpm --filter @suite/e2e e2e:views",
    "format": "biome format --write .",
    "knip": "knip",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "mutation": "stryker run stryker.graph.config.mjs",
    "mutation:quick": "stryker run stryker.quick.config.mjs",
    "scratchpad": "node scripts/scratchpad.mjs",
    "security:deps": "pnpm audit --audit-level high && pnpm audit signatures",
    "security:history": "node scripts/security-secrets.mjs --history",
    "security:osv": "node scripts/security-osv.mjs",
    "security:secrets": "node scripts/security-secrets.mjs",
    "shape": "node scripts/check-shape.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "verify": "node scripts/scratchpad.mjs --quiet && pnpm lint && pnpm typecheck:all && pnpm test && pnpm test:stories && pnpm build:all && pnpm docs:check && pnpm docs:symbols && pnpm shape && pnpm security:deps && pnpm security:secrets",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@suite/desktop": "workspace:*",
    "@suite/sync": "workspace:*",
    "@suite/ui": "workspace:*",
    "@excalidraw/excalidraw": "0.18.1",
    "@suite/graph": "workspace:*",
    "@suite/import-obsidian": "workspace:*",
    "@suite/theme": "workspace:*",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@xyflow/react": "^12.12.0",
    "fuzzysort": "^4.0.2",
    "loro-crdt": "^1.17.1",
    "loro-prosemirror": "0.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "^4.10.2",
    "knip": "^6.43.0",
    "marked": "^18.1.2",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "5.0.5",
    "yaml": "^2.9.1",
    "@iconify-json/lucide": "^1.2.147",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "storybook": "10.6.2",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
