{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["pack/vite.config.ts"],
      "project": [
        "scripts/**/*.mjs",
        "src/**/*.{ts,tsx}",
        "pack/src/**/*.ts",
        "pack/*.config.ts",
        "pack/*.config.mts",
        ".storybook/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": ["tailwindcss", "loro-crdt"]
}
