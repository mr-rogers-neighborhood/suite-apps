{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.mjs", "src/**/*.{ts,tsx}", ".storybook/**/*.ts", "e2e/**/*.ts"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "pack": {
      "project": ["src/**/*.ts", "*.config.ts", "*.config.mts"]
    }
  },
  "ignoreDependencies": ["tailwindcss", "loro-crdt"]
}
