{
  "name": "@suite/start",
  "version": "0.5.0",
  "productName": "Suite Start",
  "desktopName": "suite-start.desktop",
  "private": true,
  "description": "The Suite launcher: discovers installed apps from signed manifests, routes suite:// links and files, and starts the right process. It never holds a document.",
  "type": "module",
  "bin": {
    "suite-start-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stage.mjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:all": "pnpm --filter @suite/contracts --filter @suite/files --filter @suite/theme --filter @suite/ui --filter @suite/desktop --filter @suite/start --workspace-concurrency=1 run build",
    "typecheck:all": "pnpm --filter @suite/start --filter @suite/contracts --filter @suite/desktop --filter @suite/files --filter @suite/theme --filter @suite/ui run typecheck",
    "check": "biome check . && pnpm build:all && pnpm typecheck:all && vitest run",
    "check:full": "pnpm check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "verify": "pnpm check",
    "build:verify": "pnpm --filter @suite/contracts --filter @suite/files --filter @suite/theme --filter @suite/ui --filter @suite/desktop --filter @suite/start --workspace-concurrency=1 run build && git diff --exit-code -- ../../packages",
    "e2e": "playwright test",
    "e2e:packaged": "playwright test --config playwright.packaged.config.ts",
    "dev": "pnpm build:all && pnpm --filter @suite/start start"
  },
  "dependencies": {
    "@suite/contracts": "workspace:*",
    "@suite/desktop": "workspace:*",
    "@suite/sync": "workspace:*",
    "@suite/theme": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "@types/node": "^26.6.5",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-rogers-neighborhood/suite-apps.git",
    "directory": "apps/start"
  },
  "main": "./dist/main.js",
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
