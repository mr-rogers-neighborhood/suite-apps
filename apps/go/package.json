{
  "name": "@suite/go-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:all": "pnpm --filter @suite/go --filter @suite/go-app --workspace-concurrency=1 run build",
    "typecheck:all": "pnpm --filter @suite/go-app --filter @suite/go run typecheck",
    "build:verify": "pnpm --filter @suite/go --filter @suite/go-app --workspace-concurrency=1 run build && git diff --exit-code -- packages",
    "check": "biome check . && pnpm typecheck:all && vitest run",
    "check:full": "pnpm check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "verify": "pnpm check",
    "doctor": "node scripts/preflight.mjs",
    "android:devices": "node scripts/android.mjs devices",
    "android:install": "node scripts/android.mjs install",
    "android:watch": "node scripts/android.mjs watch",
    "android:emulator": "node scripts/android.mjs emulator",
    "android:eval": "node scripts/webeval.mjs",
    "planner:build": "pnpm --filter @suite/go-app exec vite build --config planner.vite.config.ts",
    "android:ax": "node scripts/ax.mjs",
    "pack:keygen": "node scripts/keygen.mjs",
    "pack:build": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@suite/go": "workspace:*",
    "@suite/theme": "workspace:*",
    "@suite/ui": "workspace:*",
    "fflate": "^0.8.3",
    "loro-crdt": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "fflate": "^0.8.3",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-wasm": "^3.6.0"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
