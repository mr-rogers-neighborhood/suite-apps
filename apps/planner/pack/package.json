{
  "name": "@suite/planner-pack",
  "private": true,
  "type": "module",
  "description": "Planner as an isolated Suite Go pack: a bridge prelude around Planner's own renderer.",
  "scripts": {
    "build:deps": "pnpm --filter @suite/ui --filter @suite/theme --filter @suite/document-runtime --filter @suite/sync --filter @suite/go --workspace-concurrency=1 run build",
    "build": "pnpm run build:deps && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@suite/go": "workspace:*",
    "@suite/planner-core": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "5.1.0"
  }
}
