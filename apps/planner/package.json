{
  "name": "@suite/planner",
  "productName": "Suite Planner",
  "desktopName": "run.suite.planner",
  "version": "0.5.2",
  "suite": {
    "pack": true
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build-storybook": "storybook build",
    "dev": "electron-vite dev",
    "e2e:smoke": "playwright test",
    "e2e:proof": "playwright test --grep @proof",
    "package:dir": "electron-vite build && electron-builder --dir",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:all": "pnpm --filter @suite/planner --filter @suite/planner-core run typecheck && tsc --noEmit -p pack/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:pack": "vitest run --config pack/vitest.config.mts",
    "shape": "node scripts/check-shape.mjs",
    "knip": "knip",
    "check": "biome check . && pnpm typecheck:all && vitest run --changed && pnpm test:pack && pnpm shape",
    "check:full": "pnpm lint && pnpm typecheck:all && pnpm test && pnpm test:pack && pnpm shape && pnpm knip && pnpm build",
    "verify": "biome check . && pnpm typecheck:all && vitest run && pnpm test:pack && pnpm shape && pnpm knip && pnpm build && pnpm build-storybook",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@suite/contracts": "workspace:*",
    "@suite/desktop": "workspace:*",
    "@suite/document-runtime": "workspace:*",
    "@suite/planner-core": "workspace:*",
    "@suite/sync": "workspace:*",
    "@suite/sync-desktop": "workspace:*",
    "@suite/ui": "workspace:*",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "loro-crdt": "^1.17.1",
    "loro-prosemirror": "0.4.4",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@suite/host": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "typescript": "~5.9.3",
    "vitest": "5.1.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0"
  },
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT",
  "description": "The Suite Planner desktop app: a local-first day plan in one file.",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  }
}
