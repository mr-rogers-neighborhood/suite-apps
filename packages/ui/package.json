{
  "name": "@suite/ui",
  "version": "0.17.0",
  "description": "The suite's shared primitives: a button, a field, a modal, a toast and a launcher, all painted from @suite/theme roles so a preset reaches them without a per-app copy.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chrome": {
      "types": "./dist/chrome/index.d.ts",
      "import": "./dist/chrome/index.js",
      "default": "./dist/chrome/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build-storybook": "pnpm index:stories && storybook build",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:stories && pnpm index:stories:check && pnpm build-storybook",
    "check:full": "pnpm check",
    "capture:workbench": "node scripts/capture-workbench.mjs",
    "index:stories": "node scripts/index-stories.mjs",
    "index:stories:check": "node scripts/index-stories.mjs --check",
    "pretest:stories": "node scripts/clear-storybook-cache.mjs",
    "storybook": "pnpm index:stories && storybook dev -p 6007",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --config vitest.stories.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@suite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-mcp": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@suite/theme": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^28.0.0",
    "playwright": "1.65.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.6.9",
    "storybook-addon-mock-date": "3.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrnbhd/suite-apps.git",
    "directory": "packages/ui"
  },
  "license": "MIT"
}
