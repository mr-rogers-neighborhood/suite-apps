{
  "name": "@suite/document-runtime",
  "version": "0.1.0",
  "description": "The document runtime Planner and Budget share: a renderer replica with one observe call site over any Loro document, and an atomic main-process store driven by a path and serializer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "development": "./src/node/index.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-rogers-neighborhood/suite-apps.git",
    "directory": "packages/document-runtime"
  }
}
