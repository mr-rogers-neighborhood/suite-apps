{
  "name": "@suite/contracts",
  "version": "0.17.0",
  "description": "The suite's shared vocabulary: app manifests, widget descriptors, deployment capability documents, deep links, the sync capability and contract versions. Pure Zod and pure functions; no Electron, no React, no Loro, no I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./app-manifest": {
      "types": "./dist/appManifest.d.ts",
      "development": "./src/appManifest.ts",
      "import": "./dist/appManifest.js",
      "default": "./dist/appManifest.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "development": "./src/deployment.ts",
      "import": "./dist/deployment.js",
      "default": "./dist/deployment.js"
    },
    "./deep-link": {
      "types": "./dist/deepLink.d.ts",
      "development": "./src/deepLink.ts",
      "import": "./dist/deepLink.js",
      "default": "./dist/deepLink.js"
    },
    "./version": {
      "types": "./dist/contractVersion.d.ts",
      "development": "./src/contractVersion.ts",
      "import": "./dist/contractVersion.js",
      "default": "./dist/contractVersion.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "development": "./src/release.ts",
      "import": "./dist/release.js",
      "default": "./dist/release.js"
    },
    "./suite-apps": {
      "types": "./dist/suiteApps.d.ts",
      "development": "./src/suiteApps.ts",
      "import": "./dist/suiteApps.js",
      "default": "./dist/suiteApps.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "development": "./src/sync.ts",
      "import": "./dist/sync.js",
      "default": "./dist/sync.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "development": "./src/widgets.ts",
      "import": "./dist/widgets.js",
      "default": "./dist/widgets.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrnbhd/suite-apps.git",
    "directory": "packages/contracts"
  }
}
