{
  "name": "@suite/desk",
  "version": "0.4.0",
  "productName": "Suite Desk",
  "desktopName": "run.suite.desk",
  "private": true,
  "description": "Suite Desk, the Suite host: one window that opens signed, sandboxed packs as tabs. The host owns the chrome, its space document and the capability boundary; packs own their documents.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/stage.mjs",
    "package:dir": "pnpm build:all && electron-builder --dir",
    "start": "electron .",
    "dev": "SUITE_DESK_DEV_PACKS=1 pnpm build:all && SUITE_DESK_DEV_PACKS=1 pnpm start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:all": "pnpm --filter @suite/contracts --filter @suite/screens --filter @suite/pack --filter @suite/pack-runtime --filter @suite/pack-host --filter @suite/desktop --filter @suite/theme --filter @suite/desk --workspace-concurrency=1 run build",
    "typecheck:all": "pnpm --filter @suite/desk --filter @suite/contracts --filter @suite/screens --filter @suite/pack --filter @suite/pack-runtime --filter @suite/pack-host --filter @suite/desktop --filter @suite/theme run typecheck",
    "check:packages": "pnpm --filter @suite/pack --filter @suite/pack-runtime --filter @suite/pack-host run check && pnpm --filter @suite/pack --filter @suite/pack-host test",
    "check": "pnpm build:all && pnpm check:packages && biome check . && pnpm typecheck:all && vitest run",
    "check:full": "pnpm check",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "e2e:proof": "playwright test --grep @proof",
    "verify": "pnpm check"
  },
  "dependencies": {
    "@suite/contracts": "workspace:*",
    "@suite/pack": "workspace:*",
    "@suite/pack-host": "workspace:*",
    "@suite/pack-runtime": "workspace:*",
    "@suite/screens": "workspace:*",
    "@suite/desktop": "workspace:*",
    "@suite/theme": "workspace:*",
    "loro-crdt": "^1.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrrnbhd/suite-apps.git",
    "directory": "hosts/desk"
  },
  "author": {
    "name": "Suite contributors",
    "email": "maintainers@suite.run"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22"
  }
}
